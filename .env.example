# ==============================================================================
# BUDGET PERSO PRO — CONFIGURATION DE L'INSTANCE
# ==============================================================================

# Port d'écoute externe sur le serveur / conteneur (par défaut : 3001)
PORT=3001

# Chemin du fichier de base de données SQLite dans le conteneur
DB_PATH=/app/data/budget.db

# Répertoire des fichiers statiques compilés de l'application React
STATIC_DIR=/app/dist

# Activation de l'historique personnel des crédits (2019-2026)
# IMPORTANT : Laissez à 'false' pour toutes les installations vierges distribuées aux proches.
# Définissez à 'true' uniquement pour l'instance personnelle du propriétaire historique.
VITE_ENABLE_PERSONAL_LOAN_DATASET=false
